// Generated by generate.py from registry group SecurityEvent:Logon. Do not edit by hand.
let endTime = bin(now() - 15m, 1h);
let startTime = endTime - 1h;
let base = SecurityEvent
| where TimeGenerated >= startTime and TimeGenerated < endTime
| where EventID in (4624, 4625)
| extend SourceRecordKey = tostring(hash_sha256(strcat(format_datetime(TimeGenerated, "yyyy-MM-dd HH:mm:ss.fff"), "|", Computer, "|", tostring(EventID), "|", TargetUserName, "|", IpAddress))), EventStartTime = todatetime(TimeGenerated);
union
(base
| extend _ents = pack_array(bag_pack("EntityType", "user", "Role", "Target", "Value", tostring(TargetUserName), "MappingLayer", "registry", "MappingTier", 1), bag_pack("EntityType", "ip", "Role", "Src", "Value", tostring(IpAddress), "MappingLayer", "registry", "MappingTier", 1), bag_pack("EntityType", "host", "Role", "Src", "Value", tostring(WorkstationName), "MappingLayer", "registry", "MappingTier", 1), bag_pack("EntityType", "host", "Role", "Dvc", "Value", tostring(Computer), "MappingLayer", "registry", "MappingTier", 1))
| mv-expand _e = _ents
| extend SourceTable = "SecurityEvent", SourceGroup = "SecurityEvent:Logon",
         EventVendor = "Microsoft", EventProduct = "Security Events",
         EventSchema = "Authentication", EventType = tostring(case(tostring(EventID) == "4624", "Logon", tostring(EventID) == "4625", "Logon", "")), EventResult = tostring(case(tostring(EventID) == "4624", "Success", tostring(EventID) == "4625", "Failure", "")),
         EntityType = tostring(_e.EntityType), Role = tostring(_e.Role), Value = tostring(_e.Value),
         MappingLayer = tostring(_e.MappingLayer), MappingTier = toint(_e.MappingTier)
)
| extend Value = trim(@"\s+", replace_string(replace_string(Value, '"', ""), "'", ""))
| where tolower(Value) !in ("", "-", "n/a", "na", "null", "(null)", "none", "unknown", "0.0.0.0", "::")
| extend Value = iff(EntityType in ("url", "domain"), replace_string(replace_string(replace_string(Value, "hxxp", "http"), "[.]", "."), "[:]", ":"), Value)
| extend ValueType = case(
    EntityType == "ip", iff(countof(Value, ":") >= 2, "IPv6", "IPv4"),
    EntityType == "user", case(
        Value matches regex @"^S-1-\d+(-\d+)+$", "SID",
        Value matches regex @"^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$", "AADID",
        Value contains @"\", "Windows",
        Value startswith "CN=", "DN",
        Value matches regex @"^[^@\s]+@[^@\s]+\.[^@\s]+$", "UPN",
        "Simple"),
    EntityType == "host", iff(Value contains ".", "FQDN", "Hostname"),
    EntityType == "hash", case(strlen(Value) == 32, "MD5", strlen(Value) == 40, "SHA1", strlen(Value) == 64, "SHA256", "Other"),
    EntityType == "url", "URL",
    EntityType == "email", "UPN",
    EntityType == "domain", "FQDN",
    "Other")
| extend ValueNorm = case(
    ValueType == "IPv4", extract(@"(\d{1,3}(?:\.\d{1,3}){3})", 1, Value),
    ValueType == "IPv6", tolower(trim(@"[\[\]]", tostring(split(Value, "%")[0]))),
    ValueType in ("SID", "AADID"), toupper(Value),
    ValueType == "Windows", tolower(tostring(split(Value, @"\")[1])),
    ValueType == "DN", tolower(extract(@"^CN=([^,]+)", 1, Value)),
    EntityType == "user" and ValueType == "UPN", tolower(tostring(split(Value, "@")[0])),
    EntityType == "host" and Value contains @"\", tolower(tostring(split(Value, @"\")[1])),
    EntityType == "host" and ValueType == "FQDN", tolower(tostring(split(Value, ".")[0])),
    EntityType == "domain", tolower(trim_end(@"\.", Value)),
    tolower(Value))
| where not(ValueType == "IPv4" and isnull(parse_ipv4(ValueNorm)))
| where not(EntityType == "host" and isnotnull(parse_ipv4(Value)))
| where not(EntityType == "hash" and ValueType == "Other")
| where isnotempty(ValueNorm)
| project EventStartTime, SourceTable, SourceGroup, SourceRecordKey, EventVendor, EventProduct, EventSchema, EventType, EventResult, EntityType, Role, Value, ValueNorm, ValueType, MappingLayer, MappingTier
